# OS junk
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Editor / IDE local state
.idea/
.vscode/

# Environment files (never commit -- contain secrets). The negations must
# stay after the patterns they carve out of.
.env
.env.*
!.env.example
!.env.example.*

# Logs
*.log

# Build output
target/
dist/
dist-bin/
build/
out/
test-results/
coverage/
ci
# written by `dfe-receiver --emit-helm`; the release assembles the chart from the contract
/chart/

# Rust artefacts
**/*.rs.bk
*.pdb
*.profraw
*.profdata
coverage-html/
coverage.lcov
tarpaulin-report.json
cobertura.xml

# cargo -- config.toml is committed, the rest of the directory is not.
# The pattern excludes the CONTENTS rather than the directory: git will not
# descend into an excluded directory, so `.cargo/` would make the negation
# below unreachable for anything not already tracked.
.cargo/*
!.cargo/config.toml

# Python tooling (scripts and CI helpers)
__pycache__/
*.py[cod]
*.so
.venv/
venv/
*.egg-info/
*.egg
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# Local scratch. Bare patterns (no leading slash) match at ANY depth, so
# these cover top-level .tmp/ and tmp/ as well as nested ones like
# tests/tmp/. Mirrored in attach.py _DEFAULT_EXCLUDES.
.tmp/
tmp/

# Git worktrees (local dev convenience)
.worktrees/

# Agent and AI tooling state -- local only, mirrored in .git/info/exclude.
docs/superpowers/
hyperi-ai/
.claude/
.codex/
.cursor/
.gemini/
.cursorrules
.mcp.json
.ai-version
CLAUDE.md
AGENTS.md
GEMINI.md
STATE.md
TODO.md
